{
  "buildCommand": "tsc -b && vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/geocode", "destination": "/api/geocode" },
    { "source": "/api/reverse-geocode", "destination": "/api/reverse-geocode" },
    { "source": "/api/weather", "destination": "/api/weather" },
    { "source": "/api/suggestions", "destination": "/api/suggestions" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

